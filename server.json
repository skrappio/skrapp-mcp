{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.skrappio/skrapp-mcp",
  "title": "Skrapp",
  "description": "Verified B2B emails, phones, company data and lists from Skrapp, for any MCP client.",
  "version": "1.4.2",
  "websiteUrl": "https://skrapp.io/mcp",
  "repository": {
    "url": "https://github.com/skrappio/skrapp-mcp",
    "source": "github"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.skrapp.io/"
    }
  ],
  "_meta": {
    "io.modelcontextprotocol.registry/publisher-provided": {
      "authentication": {
        "required": true,
        "oauth_required": true,
        "type": "oauth2",
        "flow": "authorization_code_pkce",
        "dynamic_client_registration": true,
        "protected_resource_metadata": "https://mcp.skrapp.io/.well-known/oauth-protected-resource",
        "authorization_server_metadata": "https://mcp.skrapp.io/.well-known/oauth-authorization-server",
        "scopes": [
          "mcp"
        ],
        "alternatives": [
          {
            "type": "api_key",
            "header": "X-Access-Key",
            "docs": "https://skrapp.io/api#mcp-api-key"
          }
        ],
        "notes": "Every request, including initialize, needs a credential. Anonymous requests get 401 with a WWW-Authenticate resource_metadata pointer. The signed-in Skrapp account must hold an active API key."
      },
      "documentation": "https://skrapp.io/mcp",
      "support": "support@skrapp.io"
    }
  }
}
